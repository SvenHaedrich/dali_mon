#!/bin/bash
[ -f .venv/bin/activate ] || python3 -m venv .venv
source ./.venv/bin/activate
# install the dependencies only for a new environment or a changed pyproject.toml
if [ ! -f .venv/.installed ] || [ pyproject.toml -nt .venv/.installed ]; then
    python3 -m pip install --upgrade pip > /dev/null
    python3 -m pip install -q -e . > /dev/null && touch .venv/.installed
fi
python3 -O source/dali_mon.py $*
